# Firebase Configuration (Required)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=


# Cloud Provider Integration IDs (Optional / Required for OAuth)
VITE_DROPBOX_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Google offline access (renewable tokens for uploads longer than 1 hour).
# Requires the api/google-token.ts Vercel Function and the server-only secret below.
VITE_GOOGLE_OFFLINE_ACCESS=true
GOOGLE_CLIENT_SECRET=

# Server-only secrets for the API functions in api/ (never prefix with VITE_)
# Encrypts the HttpOnly cookie that holds Google/Dropbox refresh tokens.
# Use 32+ random characters, e.g. `openssl rand -base64 48`.
TOKEN_COOKIE_SECRET=
# Firebase service-account key (JSON, raw or base64) for /api/commit-scan, /api/match and /api/event-info.
# It has full database access: store it only as a secret environment variable.
FIREBASE_SERVICE_ACCOUNT=
# Optional: comma-separated origins allowed to call /api/* (defaults to the deployment's own origin)
API_ALLOWED_ORIGINS=
# Admin access: set role: "admin" on users/{uid} in the Firebase console.
