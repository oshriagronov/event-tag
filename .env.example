# Firebase Configuration (Required)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=


# Cloud Provider Integration IDs (Optional / Required for OAuth)
VITE_DROPBOX_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Google offline access (renewable tokens for uploads longer than 1 hour).
# Requires the api/google-token.ts Vercel Function and the server-only secret below.
VITE_GOOGLE_OFFLINE_ACCESS=true
GOOGLE_CLIENT_SECRET=
# Optional: comma-separated origins allowed to call /api/google-token
GOOGLE_OAUTH_ALLOWED_ORIGINS=
# Admin Configuration (Optional - auto grants admin role to matching email)
VITE_ADMIN_EMAIL=