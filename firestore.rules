rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(ownerId) {
      return isAuthenticated() && ownerId == request.auth.uid;
    }

    function isValidString(str, min, max) {
      return str is string && str.size() >= min && str.size() <= max;
    }

    // Email claims are only trustworthy once the address is verified; otherwise
    // anyone could register an unverified account with a privileged address.
    function hasVerifiedEmail() {
      return request.auth.token.email != null && request.auth.token.email_verified == true;
    }

    // Admin rights come only from the role on the user's profile, which users
    // cannot set themselves. Grant the first admin in the Firebase console.
    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isUserActive() {
      return isAuthenticated() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'blocked'
      );
    }

    function isNotMaintenanceMode() {
      return !exists(/databases/$(database)/documents/system/config)
        || get(/databases/$(database)/documents/system/config).data.maintenanceMode != true;
    }

    function isUserAllowlisted() {
      return !exists(/databases/$(database)/documents/system/config)
        || get(/databases/$(database)/documents/system/config).data.allowlistMode != true
        || (hasVerifiedEmail()
            && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email.lower())));
    }

    // premiumUntil is an ISO date ("YYYY-MM-DD"); premium ends at its UTC
    // midnight, matching the client's `new Date(premiumUntil)` check.
    function isPremiumActive(premiumUntil) {
      return premiumUntil is string
        && premiumUntil.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(
          int(premiumUntil.split('-')[0]),
          int(premiumUntil.split('-')[1]),
          int(premiumUntil.split('-')[2])
        ) > request.time;
    }

    function getPhotoQuotaLimit() {
      let isPremium = request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && isPremiumActive(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('premiumUntil', null));
      let configExists = exists(/databases/$(database)/documents/system/config)
        && get(/databases/$(database)/documents/system/config).data.keys().hasAny(['quotas']);
      let config = configExists ? get(/databases/$(database)/documents/system/config).data.quotas : null;
      let standardLimit = (config != null && config.keys().hasAny(['standard']) && config.standard.keys().hasAny(['maxPhotosPerMonth'])) ? config.standard.maxPhotosPerMonth : 500;
      let premiumLimit = (config != null && config.keys().hasAny(['premium']) && config.premium.keys().hasAny(['maxPhotosPerMonth'])) ? config.premium.maxPhotosPerMonth : 10000;
      return isPremium ? premiumLimit : standardLimit;
    }

    // System Config collection (maintenanceMode, allowlistMode, quotas)
    match /system/config {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit logs collection (immutable security logs). Only admins write them,
    // under their own identity and with the server's timestamp.
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    // Allowlist collection (approved emails when allowlistMode is true).
    // Users may only check their own verified address; the full list is admin-only.
    match /allowlist/{emailDoc} {
      allow get: if isAdmin()
        || (isAuthenticated() && hasVerifiedEmail() && emailDoc == request.auth.token.email.lower());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Users collection (profiles, roles, status, premium dates)
    match /users/{userId} {
      allow get: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.get('email', '') == request.auth.token.get('email', '').lower()
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'user' || isAdmin())
        && (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status == 'active')
        && (!request.resource.data.keys().hasAny(['premiumUntil']) || request.resource.data.premiumUntil == null);
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'premiumUntil', 'email'])
      );
      // Owners delete their profile on account deletion. Blocked users cannot,
      // since a missing profile would count as active.
      allow delete: if isAdmin()
        || (isOwner(userId) && (resource == null || resource.data.get('status', 'active') != 'blocked'));

      // Rolling 30-day photo usage. Maintained by /api/commit-scan (admin SDK),
      // so clients can only read it, or delete it together with the profile.
      match /usage/{usageDoc} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isAdmin();
        allow delete: if isAdmin()
          || (isOwner(userId) && !existsAfter(/databases/$(database)/documents/users/$(userId)));
      }
    }

    // Events collection
    match /events/{eventId} {
      // Guests can fetch specific event metadata for face matching
      allow get: if true;
      // Prevent global listing, only owners or admins can list events
      allow list: if isOwner(resource.data.ownerId) || isAdmin();

      // Validate event creation
      allow create: if (isOwner(request.resource.data.ownerId) || isAdmin())
        && (isAdmin() || (isUserActive() && isNotMaintenanceMode() && isUserAllowlisted()))
        && isValidString(request.resource.data.name, 1, 100)
        && isValidString(request.resource.data.driveFolderId, 1, 200)
        && request.resource.data.photoCount is number
        && request.resource.data.faceCount is number
        && (isAdmin() || request.resource.data.photoCount <= getPhotoQuotaLimit());

      // Validate event updates
      allow update: if (isOwner(resource.data.ownerId) || isAdmin())
        && (isAdmin() || (isUserActive() && isNotMaintenanceMode()))
        && request.resource.data.ownerId == resource.data.ownerId
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) || isValidString(request.resource.data.name, 1, 100))
        && request.resource.data.photoCount is number
        && request.resource.data.faceCount is number
        && (isAdmin() || request.resource.data.photoCount <= getPhotoQuotaLimit());

      allow delete: if isOwner(resource.data.ownerId) || isAdmin();

      function isEventOwnerOrAdmin() {
        return isAdmin() || isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.ownerId);
      }

      // Photos subcollection. Guests never read it directly: /api/match returns
      // only their own matches. New photos are created by /api/commit-scan,
      // which enforces the photo quota; owners may only reset scan fields.
      match /photos/{photoId} {
        allow read: if isEventOwnerOrAdmin();
        allow create: if false;
        allow update: if isAdmin() || (
          isEventOwnerOrAdmin() && isUserActive() && isNotMaintenanceMode()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['processed', 'width', 'height'])
        );
        allow delete: if isEventOwnerOrAdmin();
      }

      // Face descriptors (biometric templates). Owner/admin read only; written
      // by /api/commit-scan; owners may delete them (rescan / event deletion).
      match /faceBatches/{batchId} {
        allow read: if isEventOwnerOrAdmin();
        allow create, update: if false;
        allow delete: if isEventOwnerOrAdmin();
      }
    }
  }
}
